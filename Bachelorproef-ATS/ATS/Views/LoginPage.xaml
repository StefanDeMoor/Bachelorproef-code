<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ATS.ViewModels"
             x:DataType="viewmodel:LoginPageViewModel"
             x:Class="ATS.Views.LoginPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Path  Data="m0.30001,0l449,0l0,128.48327c-122.5,64.30167 -332.5,65.89076 -449,7.2429c0,-45.25313 0,-90.47304 0,-135.72617z" Fill="CornflowerBlue"/>

        <StackLayout>
            <Border BackgroundColor="LightGray" HeightRequest="60" WidthRequest="60" Padding="0" Margin="0, 100, 0, 0" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
                <Image Source="user" Aspect="AspectFill" Margin="0" />
            </Border>
        </StackLayout>

        <Grid RowSpacing="5" Grid.Row="1" Margin="20, 20, 20, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Text="Welcome!" HorizontalOptions="Center" FontSize="Title" FontAttributes="Bold" Padding="0" Margin="0"/>
            <Label Grid.Row="2" Text="Sign in to continue" HorizontalOptions="Center" FontSize="Subtitle"/>

            <StackLayout Grid.Row="3" Orientation="Vertical">
                <Border BackgroundColor="Transparent" Stroke="CornflowerBlue" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Border BackgroundColor="LightGray" HeightRequest="40" Padding="0" Margin="5" Grid.Column="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Image Source="user" Aspect="AspectFill" Margin="0" WidthRequest="40" HeightRequest="40"/>
                        </Border>
                        <Entry  Text="{Binding LoginModel.Email}" Placeholder="Username" TextColor="Black" FontAttributes="Bold"
                                VerticalOptions="Center" HorizontalOptions="Fill" BackgroundColor="Transparent" Grid.Column="1"/>
                    </Grid>
                </Border>
                <Border BackgroundColor="Transparent" Stroke="CornflowerBlue" Padding="0" Margin="0, 15, 0, 0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Border BackgroundColor="LightGray" HeightRequest="40" Padding="0" Margin="5" Grid.Column="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Image Source="lock" Aspect="AspectFill" Margin="0" WidthRequest="40" HeightRequest="40"/>
                        </Border>
                        <Entry  Text="{Binding LoginModel.Password}" Placeholder="Password" TextColor="Black" FontAttributes="Bold"
                                VerticalOptions="Center" HorizontalOptions="Fill" BackgroundColor="Transparent" Grid.Column="1"/>
                    </Grid>

                </Border>

                <Label 
                    Text="{Binding ErrorMessage}" 
                    TextColor="Red" 
                    IsVisible="{Binding IsErrorVisible}" />

                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0, 10, 0, 0">
                    <CheckBox Grid.Column="0" IsChecked="False" />
                    <Label Grid.Column="1" Text="Remember me" TextColor="Black" FontSize="Small" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>
                    <Label Grid.Column="2" Text="Forgot Password?" TextColor="CornflowerBlue" FontAttributes="Bold" HorizontalOptions="End" VerticalTextAlignment="Center" />
                </Grid>

                <Button  Text="SIGN IN" 
                         BackgroundColor="CornflowerBlue" 
                         TextColor="White" 
                         FontAttributes="Bold" 
                         CornerRadius="30" 
                         WidthRequest="200" 
                         Margin="0, 15, 0, 0"
                         Command="{Binding LoginCommand}"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>